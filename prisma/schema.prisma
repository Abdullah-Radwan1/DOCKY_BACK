// Prisma schema for a compliance document analysis app

generator client {
  provider      = "prisma-client"
  output        = "../src/generated/prisma"
  moduleFormat  = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  admin
  compliance_manager
  auditor
  viewer
}

enum PlanType {
  free
  
  growth
  enterprise
}

enum DocumentStatus {
  pending
  analyzing
  analyzed
  failed
}

enum RiskLevel {
  low
  medium
  high
}

enum ComplianceQueryStatus {
  pending
  processing
  completed
  failed
}

enum NotificationStatus {
  unread
  read
  archived
}

enum NotificationType {
  expiration_warning
  compliance_alert
  system_alert
}

enum DeliveryChannel {
  in_app
  email
  push
  sms
}

enum FindingSeverity {
  info
  low
  medium
  high
  critical
}

enum AnalysisVerdict {
  compliant
  non_compliant
  partial
  unknown
}

model Organization {
  id               String         @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name             String
  slug             String         @unique
  plan             PlanType       @default(free)
  documentsLimit   Int?           @map("documents_limit") @default(3)
  createdAt        DateTime       @map("created_at") @default(dbgenerated("NOW()")) @db.Timestamptz
  updatedAt        DateTime       @map("updated_at") @default(dbgenerated("NOW()")) @db.Timestamptz

  profiles         Profile[]
  documents        Document[]
  activityLogs     ActivityLog[]

  @@index([createdAt])
  @@map("organizations")
}

model Profile {
  id               String            @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  email            String            @unique
  fullName         String?           @map("full_name")
  avatarUrl        String?           @map("avatar_url")
  role             UserRole          @default(viewer)
  organizationId   String?           @map("organization_id") @db.Uuid
  createdAt        DateTime          @map("created_at") @default(dbgenerated("NOW()")) @db.Timestamptz
  updatedAt        DateTime          @map("updated_at") @default(dbgenerated("NOW()")) @db.Timestamptz

  organization     Organization?     @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  documents        Document[]        @relation("UploadedBy")
  activityLogs     ActivityLog[]
  complianceQueries ComplianceQuery[]
  notifications    Notification[]

  @@index([organizationId])
  @@index([createdAt])
  @@map("profiles")
}

model Document {
  id               String            @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  organizationId   String            @map("organization_id") @db.Uuid
  uploadedBy       String            @map("uploaded_by") @db.Uuid
  originalFileName String            @map("original_file_name")
  filename         String
  mimeType         String?           @map("mime_type")
  storageKey       String?           @map("storage_key")
  fileUrl          String?           @map("file_url")
  checksum         String?           @map("checksum")
  fileSize         Int?              @map("file_size")
  pageCount        Int?              @map("page_count")
  language         String?           
  status           DocumentStatus    @default(pending)
  complianceScore  Int?              @map("compliance_score")
  riskLevel        RiskLevel?
  expirationDate   DateTime?         @map("expiration_date") @db.Timestamptz
  createdAt        DateTime          @map("created_at") @default(dbgenerated("NOW()")) @db.Timestamptz
  updatedAt        DateTime          @map("updated_at") @default(dbgenerated("NOW()")) @db.Timestamptz

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  uploader         Profile           @relation("UploadedBy", fields: [uploadedBy], references: [id], onDelete: Cascade)
  analyses         DocumentAnalysis[]
  complianceQueries ComplianceQuery[]
  notifications    Notification[]

  @@index([organizationId, createdAt])
  @@index([uploadedBy, createdAt])
  @@index([status, createdAt])
  @@map("documents")
}

model DocumentAnalysis {
  id                   String            @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  documentId           String            @map("document_id") @db.Uuid
  executiveSummary     String?           @map("executive_summary")
  overallVerdict       AnalysisVerdict?  @map("overall_verdict")
  confidenceScore      Float?            @map("confidence_score")
  modelName            String?           @map("model_name")
  promptVersion        String?           @map("prompt_version")
  rulesetVersion       String?           @map("ruleset_version")
  parties              Json?
  obligations          Json?
  paymentTerms         Json?             @map("payment_terms")
  renewalTerms         Json?             @map("renewal_terms")
  penalties            Json?
  governingLaw         String?           @map("governing_law")
  missingClauses       Json?             @map("missing_clauses")
  unusualConditions    Json?             @map("unusual_conditions")
  complianceRequirements Json?           @map("compliance_requirements")
  policyViolations     Json?             @map("policy_violations")
  regulatoryIssues     Json?             @map("regulatory_issues")
  missingSignatures    Json?             @map("missing_signatures")
  expirationDetected   Boolean           @map("expiration_detected") @default(false)
  importantDates       Json?             @map("important_dates")
  risks                Json?
  recommendations      Json?
  createdAt            DateTime          @map("created_at") @default(dbgenerated("NOW()")) @db.Timestamptz

  document             Document          @relation(fields: [documentId], references: [id], onDelete: Cascade)
  findings             Finding[]

  @@index([documentId, createdAt])
  @@map("document_analyses")
}

model Finding {
  id               String            @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  analysisId       String            @map("analysis_id") @db.Uuid
  title            String
  description      String?
  severity         FindingSeverity   @default(info)
  clauseReference  String?           @map("clause_reference")
  pageNumber       Int?              @map("page_number")
  excerpt          String?
  recommendation   String?
  metadata         Json?
  createdAt        DateTime          @map("created_at") @default(dbgenerated("NOW()")) @db.Timestamptz

  analysis         DocumentAnalysis  @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  @@index([analysisId, severity])
  @@map("findings")
}

model ActivityLog {
  id               String      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  organizationId   String      @map("organization_id") @db.Uuid
  userId           String?     @map("user_id") @db.Uuid
  action           String
  entityType       String?     @map("entity_type")
  entityId         String?     @map("entity_id") @db.Uuid
  metadata         Json?
  createdAt        DateTime    @map("created_at") @default(dbgenerated("NOW()")) @db.Timestamptz

  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user             Profile?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([userId, createdAt])
  @@index([entityType, entityId])
  @@map("activity_log")
}

model ComplianceQuery {
  id               String               @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  queryText        String               @map("query_text")
  status           ComplianceQueryStatus @default(pending)
  documentId       String?              @map("document_id") @db.Uuid
  userId           String               @map("user_id") @db.Uuid
  attemptCount     Int                  @map("attempt_count") @default(0)
  errorMessage     String?              @map("error_message")
  processingStartedAt DateTime?         @map("processing_started_at") @db.Timestamptz
  processingFinishedAt DateTime?        @map("processing_finished_at") @db.Timestamptz
  createdAt        DateTime             @map("created_at") @default(dbgenerated("NOW()")) @db.Timestamptz
  updatedAt        DateTime             @map("updated_at") @default(dbgenerated("NOW()")) @db.Timestamptz

  document         Document?            @relation(fields: [documentId], references: [id], onDelete: SetNull)
  user             Profile              @relation(fields: [userId], references: [id], onDelete: Cascade)
  responses        AIResponse[]

  @@index([userId, createdAt])
  @@index([documentId, createdAt])
  @@index([status, createdAt])
  @@map("compliance_queries")
}

model AIResponse {
  id               String      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  queryId          String      @map("query_id") @db.Uuid
  responseText     String      @map("response_text")
  confidenceScore  Float?      @map("confidence_score")
  metadata         Json?
  createdAt        DateTime    @map("created_at") @default(dbgenerated("NOW()")) @db.Timestamptz

  complianceQuery  ComplianceQuery @relation(fields: [queryId], references: [id], onDelete: Cascade)

  @@index([queryId, createdAt])
  @@map("ai_responses")
}

model Notification {
  id               String             @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId           String             @map("user_id") @db.Uuid
  title            String
  message          String
  type             NotificationType
  status           NotificationStatus @default(unread)
  deliveryChannel  DeliveryChannel    @map("delivery_channel") @default(in_app)
  documentId       String?            @map("document_id") @db.Uuid
  scheduledFor     DateTime?          @map("scheduled_for") @db.Timestamptz
  sentAt           DateTime?          @map("sent_at") @db.Timestamptz
  createdAt        DateTime           @map("created_at") @default(dbgenerated("NOW()")) @db.Timestamptz
  updatedAt        DateTime           @map("updated_at") @default(dbgenerated("NOW()")) @db.Timestamptz

  user             Profile            @relation(fields: [userId], references: [id], onDelete: Cascade)
  document         Document?          @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([userId, status, createdAt])
  @@index([documentId])
  @@map("notifications")
}