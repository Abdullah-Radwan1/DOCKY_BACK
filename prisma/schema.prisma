generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  admin
  compliance_manager
  auditor
  viewer
}

enum PlanType {
  free
  growth
  enterprise
}

enum DocumentStatus {
  uploaded
  extracting
  chunking
  ready
  failed
}

enum RiskLevel {
  low
  medium
  high
}

enum AnalysisRequestStatus {
  pending
  processing
  completed
  failed
}

enum NotificationStatus {
  unread
  read
  archived
}

enum NotificationType {
  expiration_warning
  compliance_alert
  system_alert
}

enum DeliveryChannel {
  in_app
  email
  push
  sms
}

enum FindingSeverity {
  info
  low
  medium
  high
  critical
}

enum AnalysisVerdict {
  compliant
  non_compliant
  partial
  unknown
}

model Organization {
  id String @id @default(uuid()) @db.Uuid

  name String

  slug String @unique

  plan PlanType @default(free)

  documentsLimit Int @default(3) @map("documents_limit")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  profiles Profile[]

  documents Document[]

  activityLogs ActivityLog[]

  @@index([createdAt])
  @@map("organizations")
}

model Profile {
  id String @id @default(uuid()) @db.Uuid

  email String @unique

  fullName String? @map("full_name")

  avatarUrl String? @map("avatar_url")

  role UserRole @default(viewer)

  organizationId String? @map("organization_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  documents Document[] @relation("UploadedBy")

  analysisRequests AnalysisRequest[]

  notifications Notification[]

  activityLogs ActivityLog[]

  @@index([organizationId])
  @@index([createdAt])
  @@map("profiles")
}

model Document {
  id String @id @default(uuid()) @db.Uuid

  organizationId String? @db.Uuid
  uploadedBy     String? @db.Uuid

  originalFileName String @map("original_file_name")

  mimeType String? @map("mime_type")

  checksum String?

  fileSize Int? @map("file_size")

  pageCount Int? @map("page_count")

  totalChunks Int? @map("total_chunks")

  language String?

  status DocumentStatus @default(uploaded)

  expirationDate DateTime? @map("expiration_date") @db.Timestamptz

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  uploader Profile? @relation("UploadedBy", fields: [uploadedBy], references: [id], onDelete: Cascade)

  chunks DocumentChunk[]

  analysisRequests AnalysisRequest[]

  notifications Notification[]

  @@index([organizationId])
  @@index([uploadedBy])
  @@index([status])
  @@index([createdAt])
  @@map("documents")
}

model DocumentChunk {
  id String @id @default(uuid()) @db.Uuid

  documentId String @db.Uuid

  chunkIndex Int

  content String

  pageNumber Int?

  tokenCount Int?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, chunkIndex])
  @@index([documentId])
  @@index([documentId, pageNumber])
  @@map("document_chunks")
}

model AnalysisResult {
  id             String           @id @default(uuid()) @db.Uuid
  summary        String?          @map("executive_summary")
  overallVerdict AnalysisVerdict? @map("overall_verdict")
  confidence     Float?           @map("confidence_score")
  riskLevel      RiskLevel?

  createdAt  DateTime @default(dbgenerated("NOW()")) @map("created_at") @db.Timestamptz
  responseId String   @unique @db.Uuid

  Response AIResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  findings Finding[]

  @@map("document_analyses")
}

model Finding {
  id              String          @id @default(uuid()) @db.Uuid
  analysisId      String          @map("analysis_id") @db.Uuid
  title           String
  description     String?
  severity        FindingSeverity @default(info)
  clauseReference String?         @map("clause_reference")
  pageNumber      Int?            @map("page_number")
  excerpt         String?
  recommendation  String?
  metadata        Json?
  createdAt       DateTime        @default(dbgenerated("NOW()")) @map("created_at") @db.Timestamptz

  analysis AnalysisResult @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  @@index([analysisId, severity])
  @@map("findings")
}

model ActivityLog {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  userId         String?  @map("user_id") @db.Uuid
  action         String
  entityType     String?  @map("entity_type")
  entityId       String?  @map("entity_id") @db.Uuid
  metadata       Json?
  createdAt      DateTime @default(dbgenerated("NOW()")) @map("created_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         Profile?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([userId, createdAt])
  @@index([entityType, entityId])
  @@map("activity_log")
}

model AnalysisRequest {
  id                   String                @id @default(uuid()) @db.Uuid
  queryText            String                @map("query_text")
  status               AnalysisRequestStatus @default(pending)
  documentId           String?               @map("document_id") @db.Uuid
  userId               String                @map("user_id") @db.Uuid
  attemptCount         Int                   @default(0) @map("attempt_count")
  errorMessage         String?               @map("error_message")
  processingStartedAt  DateTime?             @map("processing_started_at") @db.Timestamptz
  processingFinishedAt DateTime?             @map("processing_finished_at") @db.Timestamptz
  createdAt            DateTime              @default(dbgenerated("NOW()")) @map("created_at") @db.Timestamptz
  updatedAt            DateTime              @default(dbgenerated("NOW()")) @map("updated_at") @db.Timestamptz

  document Document?   @relation(fields: [documentId], references: [id], onDelete: SetNull)
  user     Profile     @relation(fields: [userId], references: [id], onDelete: Cascade)
  response AIResponse? // 1:1 on this side is fine

  @@index([userId, createdAt])
  @@index([documentId, createdAt])
  @@index([status, createdAt])
  @@map("compliance_queries")
}

model AIResponse {
  id              String          @id @default(uuid()) @db.Uuid
  requestId       String          @unique @map("query_id") @db.Uuid
  response        Json            @map("response_text")
  confidenceScore Float?          @map("confidence_score")
  metadata        Json?
  createdAt       DateTime        @default(dbgenerated("NOW()")) @map("created_at") @db.Timestamptz
  matchedChunks   Json?
  AnalysisRequest AnalysisRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  // This side must be marked optional (?) because an AIResponse can exist before the analysis calculation finishes.
  AnalysisResult  AnalysisResult?

  @@index([requestId, createdAt])
  @@map("ai_responses")
}

model Notification {
  id              String             @id @default(uuid()) @db.Uuid
  userId          String             @map("user_id") @db.Uuid
  title           String
  message         String
  type            NotificationType
  status          NotificationStatus @default(unread)
  deliveryChannel DeliveryChannel    @default(in_app) @map("delivery_channel")
  documentId      String?            @map("document_id") @db.Uuid
  scheduledFor    DateTime?          @map("scheduled_for") @db.Timestamptz
  sentAt          DateTime?          @map("sent_at") @db.Timestamptz
  createdAt       DateTime           @default(dbgenerated("NOW()")) @map("created_at") @db.Timestamptz
  updatedAt       DateTime           @default(dbgenerated("NOW()")) @map("updated_at") @db.Timestamptz

  user     Profile   @relation(fields: [userId], references: [id], onDelete: Cascade)
  document Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([userId, status, createdAt])
  @@index([documentId])
  @@map("notifications")
}
